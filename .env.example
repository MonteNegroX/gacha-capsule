# Private test bench at /lab. Not linked from the public site.
# At least 12 characters. Leave empty to keep the lab off.
GACHA_LAB_SECRET=

# true spends USDC from the Collector Crypt bot wallet. Leave false.
GACHA_LAB_LIVE=false

# Folder with the working opener (npm run open).
GACHA_BOT_DIR=C:\Users\main\collector-gacha-bot

# Robinhood address that receives USDG pack payments. Empty keeps payment checks off.
GACHA_TREASURY_ADDRESS=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
GACHA_PAYMENT_CONFIRMATIONS=1
